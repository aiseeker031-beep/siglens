# CRYPTOLENS Runtime Configuration
# Zero paid API keys are required. All market data uses free public exchange/DeFi APIs.
# Optional BYOK AI keys are supplied per-user in the Settings UI (session-only or browser AES-GCM vault).

PORT=3000
NODE_ENV=development

# Set to true only when self-hosting locally alongside an Ollama instance on 127.0.0.1:11434
ALLOW_LOCAL_OLLAMA=false
